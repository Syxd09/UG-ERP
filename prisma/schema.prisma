generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum DocumentType {
  QUOTATION
  PROFORMA_INVOICE
  TAX_INVOICE
}

enum DocumentStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Company {
  id              String           @id @default(uuid())
  name            String           @default("Ultimate Graphics")
  legalName       String           @default("Ultimate Graphics London Ltd")
  tagline         String?          @default("Signage • Printing • Branding • Fabrication")
  gstin           String?
  pan             String?
  state           String           @default("Karnataka")
  stateCode       String           @default("29")
  email           String           @default("hello@ultimategraphics.com")
  phone           String           @default("+91 98860 12345")
  website         String?          @default("https://ultimategraphics.com")
  address         String           @default("124 Industrial Area, Main Road")
  city            String           @default("Bengaluru")
  pincode         String           @default("560001")
  logoUrl         String?          @default("/logos/main-logo.png")
  symbolLogoUrl   String?          @default("/logos/symbol-logo.jpeg")
  signatureUrl    String?
  bankAccounts    BankAccount[]
  upiDetails      UpiDetail[]
  settings        CompanySettings?
  sequences       DocumentSequence[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model BankAccount {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountHolder String
  bankName      String
  accountNumber String
  ifsc          String
  branch        String?
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UpiDetail {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  upiId     String
  payeeName String
  qrCodeUrl String?
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id                           String   @id @default(uuid())
  companyId                    String   @unique
  company                      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoicePrefix                String   @default("UG/INV")
  quotationPrefix              String   @default("UG/QTN")
  proformaPrefix               String   @default("UG/PI")
  financialYear                String   @default("2026-27")
  defaultPaymentTerms          String   @default("50% Advance with Purchase Order, 50% Balance on Delivery & Installation.")
  defaultQuotationValidityDays Int      @default(30)
  defaultTaxRate               Decimal  @default(18.00) @db.Decimal(5, 2)
  defaultNotes                 String?  @default("Thank you for your business. We look forward to working with you!")
  defaultTerms                 String?  @default("1. Prices quoted are inclusive/exclusive of GST as specified.\n2. Standard delivery timeline: 7-10 business days from artwork approval.\n3. Site readiness, electrical connection point, and permissions are client responsibility.\n4. Quotation remains valid for 30 calendar days from issue date.\n5. Any additional alterations to approved designs will be billed additionally.")
  enableRoundOff               Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model DocumentSequence {
  id            String       @id @default(uuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docType       DocumentType
  prefix        String
  financialYear String
  currentNumber Int          @default(0)
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, docType, financialYear])
}

model Customer {
  id                  String     @id @default(uuid())
  companyName         String
  contactPerson       String?
  email               String?
  phone               String?
  gstin               String?
  pan                 String?
  billingAddress      String
  billingCity         String?
  billingState        String     @default("Karnataka")
  billingStateCode    String     @default("29")
  billingPincode      String?
  shippingAddress     String?
  shippingCity        String?
  shippingState       String?
  shippingStateCode   String?
  shippingPincode     String?
  notes               String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  documents           Document[]
}

model ProductService {
  id             String   @id @default(uuid())
  name           String
  category       String   // SIGNAGE, FABRICATION, PRINTING, BRANDING, OTHER
  description    String?
  hsnSac         String?  // HSN code (goods) or SAC code (services)
  unit           String   @default("Nos")
  defaultRate    Decimal  @default(0.00) @db.Decimal(12, 2)
  defaultGstRate Decimal  @default(18.00) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Document {
  id                      String                @id @default(uuid())
  documentNumber          String                @unique
  documentType            DocumentType
  status                  DocumentStatus        @default(DRAFT)
  issueDate               DateTime              @default(now())
  dueDate                 DateTime?
  validityDate            DateTime?
  referenceNo             String?
  projectRef              String?
  projectName             String?
  projectLocation         String?
  siteAddress             String?

  customerId              String?
  customer                Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  customerContactPerson   String?
  customerEmail           String?
  customerPhone           String?
  customerGstin           String?
  customerBillingAddress  String
  customerShippingAddress String?
  placeOfSupplyState      String                @default("Karnataka")
  placeOfSupplyCode       String                @default("29")
  isInterState            Boolean               @default(false)

  // Calculations
  subtotal                Decimal               @default(0.00) @db.Decimal(12, 2)
  discountType            DiscountType          @default(PERCENTAGE)
  discountValue           Decimal               @default(0.00) @db.Decimal(12, 2)
  discountAmount          Decimal               @default(0.00) @db.Decimal(12, 2)
  taxableAmount           Decimal               @default(0.00) @db.Decimal(12, 2)
  cgstAmount              Decimal               @default(0.00) @db.Decimal(12, 2)
  sgstAmount              Decimal               @default(0.00) @db.Decimal(12, 2)
  igstAmount              Decimal               @default(0.00) @db.Decimal(12, 2)
  totalTaxAmount          Decimal               @default(0.00) @db.Decimal(12, 2)
  roundOff                Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAmount             Decimal               @default(0.00) @db.Decimal(12, 2)

  // Payments
  advancePercentage       Decimal?              @db.Decimal(5, 2)
  advanceAmount           Decimal?              @db.Decimal(12, 2)
  amountReceived          Decimal               @default(0.00) @db.Decimal(12, 2)
  balanceDue              Decimal               @default(0.00) @db.Decimal(12, 2)

  paymentTerms            String?
  notes                   String?
  termsAndConditions      String?

  // Snapshots for audit immutability
  companySnapshot         Json?
  bankSnapshot            Json?
  upiSnapshot             Json?

  isLocked                Boolean               @default(false)
  convertedFromId         String?
  convertedToId           String?

  items                   DocumentItem[]
  taxSummaries            DocumentTaxSummary[]
  payments                Payment[]
  conversionsAsSource     DocumentConversion[]  @relation("SourceDocument")
  conversionsAsTarget     DocumentConversion[]  @relation("TargetDocument")

  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([documentType, status])
  @@index([customerId])
  @@index([issueDate])
}

model DocumentItem {
  id             String       @id @default(uuid())
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  hsnSac         String?
  unit           String       @default("Nos")
  dimensions     String?      // e.g. "10 ft x 4 ft"
  specifications String?      // e.g. "3mm ACP, Samsung LED, Meanwell Power Supply"
  quantity       Decimal      @default(1.00) @db.Decimal(12, 2)
  unitRate       Decimal      @default(0.00) @db.Decimal(12, 2)
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.00) @db.Decimal(12, 2)
  taxableAmount  Decimal      @default(0.00) @db.Decimal(12, 2)
  gstRate        Decimal      @default(18.00) @db.Decimal(5, 2)
  isGstInclusive Boolean      @default(false)
  cgstRate       Decimal      @default(0.00) @db.Decimal(5, 2)
  cgstAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  sgstRate       Decimal      @default(0.00) @db.Decimal(5, 2)
  sgstAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  igstRate       Decimal      @default(0.00) @db.Decimal(5, 2)
  igstAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  totalTax       Decimal      @default(0.00) @db.Decimal(12, 2)
  finalAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  sortOrder      Int          @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([documentId])
}

model DocumentTaxSummary {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  hsnSac        String?
  gstRate       Decimal  @db.Decimal(5, 2)
  taxableAmount Decimal  @db.Decimal(12, 2)
  cgstAmount    Decimal  @db.Decimal(12, 2)
  sgstAmount    Decimal  @db.Decimal(12, 2)
  igstAmount    Decimal  @db.Decimal(12, 2)
  totalTax      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@index([documentId])
}

model Payment {
  id             String        @id @default(uuid())
  documentId     String
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paymentNumber  String        @unique
  paymentDate    DateTime      @default(now())
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  transactionRef String?
  bankName       String?
  notes          String?
  receivedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([documentId])
  @@index([paymentDate])
}

model DocumentConversion {
  id               String       @id @default(uuid())
  sourceDocumentId String
  sourceDocument   Document     @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocumentId String
  targetDocument   Document     @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  sourceDocNumber  String
  targetDocNumber  String
  sourceType       DocumentType
  targetType       DocumentType
  convertedAt      DateTime     @default(now())
  convertedBy      String?
  notes            String?

  @@index([sourceDocumentId])
  @@index([targetDocumentId])
}

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String   // Document, Customer, ProductService, Payment, Settings
  entityId    String
  action      String   // CREATE, UPDATE, DELETE, CONVERT, LOCK, UNLOCK, PAYMENT_ADDED
  performedBy String?
  user        User?    @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}
